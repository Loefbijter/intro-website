# Copy to .env and fill in real values. Never commit .env.

# Django secret key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-generate-a-real-secret-key

# True for local dev only. Must be False in prod.
DEBUG=False

# Comma-separated list, e.g. intro.loefbijter.nl
ALLOWED_HOSTS=intro.loefbijter.nl

# Comma-separated list, e.g. https://intro.loefbijter.nl
CSRF_TRUSTED_ORIGINS=https://intro.loefbijter.nl

# SQLite database file path inside the backend container.
# Prod uses the "db" named volume mounted at /data.
DB_PATH=/data/db.sqlite3

# Django collectstatic / media roots inside the backend container.
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

# Days to keep registrations before purge_old_registrations deletes them.
RETENTION_DAYS=30

# PROD ONLY — leave unset in dev. Setting this prevents
# docker-compose.override.yml (dev-only) from being auto-applied on the
# server. See deploy/deploy.md.
# COMPOSE_FILE=docker-compose.yml
