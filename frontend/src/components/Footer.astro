---
import logo from "../assets/logo.png";

const quickLinks = [
  { label: "Wie zijn wij?", href: "https://loefbijter.nl/wie-zijn-wij/" },
  { label: "Activiteiten", href: "https://loefbijter.nl/activiteiten-2/" },
  { label: "Zeilen", href: "https://loefbijter.nl/zeilen/" },
  { label: "Veelgestelde vragen", href: "https://loefbijter.nl/elementor-138/" },
  { label: "Winkel", href: "https://loefbijter.nl/shop/" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col">
      <img src={logo.src} alt="NSZV De Loefbijter" class="site-footer__logo" />
      <h4>N.S.Z.V. De Loefbijter</h4>
      <p>
        Villa van Schaeck<br />
        Van Schaeck Mathonsingel 10<br />
        6512 AP Nijmegen
      </p>
    </div>

    <div class="site-footer__col">
      <h4>Meer Loefbijter?</h4>
      <p>Check onze social media!</p>
      <a href="https://www.instagram.com/loefbijter/" target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
    </div>

    <div class="site-footer__col">
      <h4>Snel naar...</h4>
      <ul class="site-footer__links">
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <a href="https://loefbijter.nl/privacyverklaring/">Privacyverklaring</a>
    <span>&copy; {year} Nijmeegse Studenten Zeilvereniging "De Loefbijter"</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: #fff;
    margin-top: var(--space-5);
    padding-block: var(--space-4);
  }

  .site-footer h4 {
    color: #fff;
  }

  .site-footer a {
    color: #fff;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-3);
  }

  .site-footer__logo {
    height: 48px;
    width: auto;
    margin-bottom: var(--space-1);
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .site-footer__bottom {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    font-size: 0.85rem;
  }

  @media (min-width: 800px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
