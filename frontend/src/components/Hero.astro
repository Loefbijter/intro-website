---
import { Content, frontmatter } from "../content/hero.md";
import flyer from "../assets/flyer-introweek-2026.jpeg";
import JumpNav from "./JumpNav.astro";
---

<section class="hero container">
  <div class="hero__text">
    <h1>{frontmatter.title}</h1>
    <div class="hero__copy">
      <Content />
    </div>
    <div class="hero__actions">
      <a
        href={frontmatter.eetactieUrl}
        class="button"
        target="_blank"
        rel="noopener noreferrer"
      >
        {frontmatter.eetactieText}
      </a>
    </div>
    <JumpNav />
  </div>
  <figure class="hero__flyer">
    <a href={flyer.src} target="_blank" rel="noopener noreferrer">
      <img src={flyer.src} alt={frontmatter.flyerAlt} width="1024" height="1280" />
    </a>
    <figcaption>Tik op de flyer om het volledige programma te bekijken.</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4);
    align-items: start;
  }

  .hero__copy :global(p) {
    margin: 0 0 var(--space-2);
  }

  .hero__actions {
    margin-bottom: var(--space-3);
  }

  .hero__flyer {
    margin: 0;
  }

  .hero__flyer img {
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(122, 36, 23, 0.18);
    width: 100%;
    height: auto;
  }

  .hero__flyer figcaption {
    margin-top: var(--space-1);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (min-width: 800px) {
    .hero {
      grid-template-columns: 3fr 2fr;
    }

    .hero__flyer {
      align-self: start;
      position: sticky;
      top: var(--space-2);
    }
  }
</style>
